# ──────────────────────────────────────────────
# InventarioGP — Backend Environment Variables
# ──────────────────────────────────────────────
# COPIA este archivo como .env y completa los valores reales
# NUNCA comitees .env al repositorio

# Servidor
PORT=3001
NODE_ENV=development

# SQL Server — Credenciales de base de datos
DB_SERVER=127.0.0.1
DB_USER=sa
DB_PASSWORD=CambiaEstaContrasennaSegura!
DB_INVENTARIO=InventarioGP
DB_SIGA=SIGA_ASISTENCIA
DB_GP2024=dbGP_2024_GP

# JWT — Secreto y expiración
JWT_SECRET=genera-un-secreto-seguro-con-32-caracteres-o-mas
JWT_EXPIRES_IN=8h

# CORS — Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging — 'dev' | 'combined' | 'tiny'
LOG_FORMAT=dev

# Actas Electrónicas
ACTAS_PUBLIC_URL=http://localhost:5173
ACTAS_STORAGE_PATH=D:\inventariogp\backend\assets\actas
ACTAS_LINK_TTL_HOURS=72
# Rutas de red del PDF firmado de ENTREGA por tipo de equipo (vacío = almacenamiento local)
ACTAS_FIRMA_PDF_ENTREGA_RUTA_LAPTOP=\\10.10.1.1\10.Sistemas\Documentos\CARGO DE ENTREGA\20260815 LAPTOPS
ACTAS_FIRMA_PDF_ENTREGA_RUTA_CELULAR=\\10.10.1.1\10.Sistemas\Documentos\CARGO DE ENTREGA\20260815 - CELULARES
# Rutas de red del PDF firmado de DEVOLUCION por tipo de equipo (vacío = almacenamiento local)
ACTAS_FIRMA_PDF_DEVOLUCION_RUTA_LAPTOP=\\10.10.1.1\10.Sistemas\Documentos\CARGO DE DEVOLUCION\CARGO DEVOLUCIÓN LAPTOP
ACTAS_FIRMA_PDF_DEVOLUCION_RUTA_CELULAR=\\10.10.1.1\10.Sistemas\Documentos\CARGO DE DEVOLUCION\20251810 - CARGO DE DEVOLUCIÓN DE EQUIPO CELULAR
